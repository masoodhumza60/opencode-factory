 }
 
+const LEGAL_TRANSITIONS = {
+  pending: ["paid", "cancelled"],
+  paid: ["shipped"],
+};
+const ALL_STATUSES = new Set(["pending", "paid", "shipped", "cancelled"]);
+
+// PATCH /api/orders/:id ΓÇö the status transition machine. Board moves an order:
+// pending -> paid | cancelled, paid -> shipped. Anything else is 409, an
+// unknown id is 404, a missing/unknown status is 400, and the caller needs
+// orders.write (same roles that hold orders.read, per the spec).
+export async function patchOrder(db, req, res, session, id) {
+  if (!can(session, "orders.write")) {
+    return sendJson(res, 401, { error: "sign in required" });
+  }
+  const row = db.prepare(SELECT + " WHERE o.id = ?").get(id);
+  if (!row) return sendJson(res, 404, { error: "no such order" });
+  let body = {};
+  try {
+    body = await readJsonBody(req);
+  } catch {
+    return sendJson(res, 400, { error: "body must be JSON" });
+  }
+  const next = body && typeof body.status === "string" ? body.status : null;
+  if (next === null || !ALL_STATUSES.has(next)) {
+    return sendJson(res, 400, { error: "status is required", expected: ["pending", "paid", "shipped", "cancelled"] });
+  }
+  const allowed = LEGAL_TRANSITIONS[row.status] ?? [];
+  if (!allowed.includes(next)) {
+    return sendJson(res, 409, { error: `illegal transition: ${row.status} -> ${next}` });
+  }
+  db.prepare("UPDATE orders SET status = ? WHERE id = ?").run(next, id);
+  const updated = db.prepare(SELECT + " WHERE o.id = ?").get(id);
+  return sendJson(res, 200, { order: updated });
+}
